# All optional — the free public LanguageTool API needs no key.
# LANGUAGETOOL_API_URL=https://api.languagetool.org/v2/check
# LANGUAGETOOL_LANGUAGE=en-US

# Optional: adds sentence-structure/clarity suggestions on top of
# LanguageTool's grammar/spelling checks. Leave unset to stay fully free —
# this pass is skipped entirely with no key. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-4-5
