{
  "manifest_version": 3,
  "name": "Grammar Writer",
  "version": "0.1.0",
  "description": "Grammar, spelling, and style suggestions for any text field in your browser.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grammar Writer"
  }
}
